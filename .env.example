DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fastapi_starter

# JWT
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=60
VERIFICATION_TOKEN_TTL_HOURS=24
REFRESH_TOKEN_TTL_DAYS=7
TRUSTED_PROXIES=

# Frontend URL (used in email links)
FRONTEND_URL=http://localhost:3000

# Deployment environment ("development" | "staging" | "production")
# Controls dev-only behaviour — set to "production" in prod to suppress token logging
APP_ENV=development

# SendGrid — leave empty to log reset links to stdout in dev (APP_ENV=development only)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# Password reset token TTL
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
