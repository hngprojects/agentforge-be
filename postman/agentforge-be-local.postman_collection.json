{
  "info": {
    "_postman_id": "c0f8f936-62d4-4db3-8a84-1ad1f8650f18",
    "name": "AgentForge BE - Local Auth Pack",
    "description": "Local Postman collection for AgentForge backend auth, refresh-cookie flows, password reset, and OAuth callback smoke testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('health is ok', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('status', 'ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/health"
          }
        }
      ]
    },
    {
      "name": "Email + Password Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('register returns created or conflict', function () {",
                  "  pm.expect([201, 409]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"display_name\": \"{{display_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/auth/register"
          }
        },
        {
          "name": "GET /auth/verify-email",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('verification endpoint responded', function () {",
                  "  pm.expect([200, 400, 401, 404]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/auth/verify-email?token={{verification_token}}"
          }
        },
        {
          "name": "POST /auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns access token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('access_token');",
                  "  pm.environment.set('access_token', body.access_token);",
                  "});",
                  "pm.test('refresh cookie was set', function () {",
                  "  pm.expect(pm.response.headers.get('Set-Cookie') || '').to.include('refresh_token=');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/auth/login"
          }
        },
        {
          "name": "GET /auth/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('current user returned', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json()).to.have.property('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/auth/me"
          }
        },
        {
          "name": "POST /auth/refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('refresh rotates cookie and returns access token', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('access_token');",
                  "  pm.environment.set('access_token', body.access_token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/auth/refresh"
          }
        },
        {
          "name": "POST /auth/logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('logout succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.environment.unset('access_token');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Password Reset",
      "item": [
        {
          "name": "POST /auth/forgot-password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('forgot password always returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/auth/forgot-password"
          }
        },
        {
          "name": "POST /auth/reset-password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('reset password endpoint responded', function () {",
                  "  pm.expect([200, 400, 422]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{reset_token}}\",\n  \"new_password\": \"{{new_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}{{api_prefix}}/auth/reset-password"
          }
        }
      ]
    },
    {
      "name": "Google OAuth",
      "item": [
        {
          "name": "GET /auth/google - start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('google start redirects', function () {",
                  "  pm.response.to.have.status(307);",
                  "});",
                  "const location = pm.response.headers.get('Location') || pm.response.headers.get('location');",
                  "if (location) {",
                  "  pm.environment.set('google_authorize_url', location);",
                  "  const parsed = new URL(location);",
                  "  pm.environment.set('google_state', parsed.searchParams.get('state') || '');",
                  "}",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const cookieMatch = setCookie.match(/oauth_state=([^;]+)/);",
                  "if (cookieMatch) {",
                  "  pm.environment.set('google_state_cookie', cookieMatch[1].replace(/^\\\"|\\\"$/g, ''));",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/auth/google"
          }
        },
        {
          "name": "GET /auth/google/callback - manual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('access_token', body.access_token);",
                  "}",
                  "pm.test('google callback endpoint responded', function () {",
                  "  pm.expect([200, 400, 401, 502]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "oauth_state={{google_state_cookie}}"
              }
            ],
            "url": "{{base_url}}{{api_prefix}}/auth/google/callback?code={{google_code}}&state={{google_state}}"
          }
        }
      ]
    },
    {
      "name": "GitHub OAuth",
      "item": [
        {
          "name": "GET /auth/github - start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('github start redirects or reports missing config', function () {",
                  "  pm.expect([302, 501]).to.include(pm.response.code);",
                  "});",
                  "const location = pm.response.headers.get('Location') || pm.response.headers.get('location');",
                  "if (location) {",
                  "  pm.environment.set('github_authorize_url', location);",
                  "  const parsed = new URL(location);",
                  "  pm.environment.set('github_state', parsed.searchParams.get('state') || '');",
                  "}",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const cookieMatch = setCookie.match(/oauth_state_nonce=([^;]+)/);",
                  "if (cookieMatch) {",
                  "  pm.environment.set('github_oauth_nonce', cookieMatch[1].replace(/^\\\"|\\\"$/g, ''));",
                  "}"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}{{api_prefix}}/auth/github"
          }
        },
        {
          "name": "GET /auth/github/callback - manual",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('access_token', body.access_token);",
                  "}",
                  "pm.test('github callback endpoint responded', function () {",
                  "  pm.expect([200, 400, 401, 501, 502]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Cookie",
                "value": "oauth_state_nonce={{github_oauth_nonce}}"
              }
            ],
            "url": "{{base_url}}{{api_prefix}}/auth/github/callback?code={{github_code}}&state={{github_state}}"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000"
    },
    {
      "key": "api_prefix",
      "value": "/api/v1"
    }
  ]
}
